---
import ParticleText from '../components/ParticleText.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero" data-scene="0">
    <div class="hero-stack">
      <div class="hero-title">
        <ParticleText
          text={SITE_TITLE}
          particleSize={1.95}
          density={1.55}
          color="#000000"
          highlightColor="#000000"
          glow={false}
          scatter={82}
          gatherDuration={1250}
          stagger={260}
          repelRadius={104}
          idleDrift={0.7}
          fontSize="clamp(4.1rem, 11vw, 8.8rem)"
          fontWeight={900}
        />
        <p class="hero-kicker">把解决过的问题，</p>
        <p class="hero-kicker">写成可复用的判断。</p>
      </div>
      <p class="hero-copy">
        记录工程实践、源码阅读、工具流和长期技术思考。把真正解决过的问题沉稳下来，留给未来的自己快速复用。
      </p>
    </div>
  </section>

  <section class="section archive-section" aria-labelledby="post-archive" data-scene="1">
    <div class="section-heading">
      <h2 id="post-archive">文章归档</h2>
      <p>每篇文章都尽量保留问题背景、排查路径和最终判断，方便未来回看。</p>
    </div>
    <div class="archive-panel" aria-label="文章列表">
      <ul class="post-list">
        {
          posts.map((post) => (
            <li class="post-card">
              <a class="post-link" href={`/posts/${post.slug}/`}>
                <time class="post-date" datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('zh-CN')}
                </time>
                <div>
                  <h2>{post.data.title}</h2>
                  <p class="post-description">{post.data.description}</p>
                  <div class="tags">
                    {post.data.tags.map((tag: string) => <span>{tag}</span>)}
                  </div>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
