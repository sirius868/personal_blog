---
import ParticleText from '../components/ParticleText.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const rawPosts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const posts = rawPosts.map((post) => {
  const tags = post.data.tags ?? [];
  const category = tags[0] ?? '未分类';
  const plainText = post.body.replace(/```[\s\S]*?```/g, '').replace(/!\[[^\]]*\]\([^)]+\)/g, '');
  const charCount = Math.max(1, plainText.replace(/\s+/g, '').length);
  const readMinutes = Math.max(1, Math.round(charCount / 260));

  return {
    slug: post.slug,
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    category,
    tags,
    charCount,
    readMinutes
  };
});

const categoryCounts = posts.reduce<Record<string, number>>((acc, post) => {
  acc[post.category] = (acc[post.category] ?? 0) + 1;
  return acc;
}, {});

const tagCounts = posts.reduce<Record<string, number>>((acc, post) => {
  post.tags.forEach((tag) => {
    acc[tag] = (acc[tag] ?? 0) + 1;
  });
  return acc;
}, {});

const categories = [
  { label: '全部', value: 'all', count: posts.length },
  ...Object.entries(categoryCounts).map(([label, count]) => ({
    label,
    value: label,
    count
  }))
];

const tagsSidebar = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .map(([label, count]) => ({ label, count }));
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero home-hero" data-scene="0">
    <div class="hero-stack">
      <div class="hero-title">
        <ParticleText
          text={SITE_TITLE}
          particleSize={1.95}
          density={1.55}
          color="#000000"
          highlightColor="#000000"
          glow={false}
          scatter={82}
          gatherDuration={1250}
          stagger={260}
          repelRadius={104}
          idleDrift={0.7}
          fontSize="clamp(4.1rem, 11vw, 8.8rem)"
          fontWeight={900}
        />
        <p class="hero-kicker">把解决过的问题，写成可复用的判断。</p>
      </div>
      <p class="hero-copy">
        记录工程实践、源码阅读、工具流和长期技术思考。把真正解决过的问题沉稳下来，留给未来的自己快速复用。
      </p>
      <a class="scroll-hint" href="#articles" aria-label="进入文章列表">
        <span>向下滚动查看文章</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="M12 5v14M6 13l6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </section>

  <section class="article-hub" id="articles" aria-label="文章展示页">
    <aside class="sidebar">
      <label class="search-box" for="post-search">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="M11 4a7 7 0 1 0 4.2 12.6l4.2 4.2 1.4-1.4-4.2-4.2A7 7 0 0 0 11 4Zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10Z" fill="currentColor"></path>
        </svg>
        <input id="post-search" data-post-search type="search" placeholder="搜索文章、内容或标签" autocomplete="off" />
      </label>


      <article class="sidebar-card">
        <div class="sidebar-head">
          <h2>分类</h2>
          <button class="reset-btn" type="button" data-clear-filters>重置</button>
        </div>
        <div class="category-list animated-list" role="list" data-animated-list data-list-type="category">
          {
            categories.map((item) => (
              <button
                class:list={['category-item', item.value === 'all' && 'is-active']}
                type="button"
                data-category-filter={item.value}
              >
                <span>{item.label}</span>
                <strong>{item.count}</strong>
              </button>
            ))
          }
        </div>
      </article>

      <article class="sidebar-card">
        <div class="sidebar-head">
          <h2>标签</h2>
        </div>
        <div class="tag-cloud animated-list" data-animated-list data-list-type="tag">
          {
            tagsSidebar.map((item) => (
              <button class="tag-item" type="button" data-tag-filter={item.label}>
                <span>{item.label}</span>
                <strong>{item.count}</strong>
              </button>
            ))
          }
        </div>
      </article>
    </aside>

    <div class="feed">
      <div class="feed-toolbar">
        <p class="feed-count"><strong data-result-count>{posts.length}</strong> 篇文章</p>
      </div>

      <div class="feed-list animated-list article-list" data-animated-list data-list-type="article">
        {
          posts.map((post) => (
            <a
              class="feed-card"
              href={`/posts/${post.slug}/`}
              data-post-card
              data-title={post.title}
              data-description={post.description}
              data-category={post.category}
              data-tags={post.tags.join('|')}
            >
              <div class="feed-card__body">
                <div class="feed-card__title">
                  <span class="feed-card__accent"></span>
                  <h2>{post.title}</h2>
                </div>

                <div class="meta-row">
                  <span class="meta-pill">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
                      <path d="M7 2v3M17 2v3M3.5 9h17M5.5 6h13A2.5 2.5 0 0 1 21 8.5v10A2.5 2.5 0 0 1 18.5 21h-13A2.5 2.5 0 0 1 3 18.5v-10A2.5 2.5 0 0 1 5.5 6Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                    </svg>
                    {post.pubDate.toLocaleDateString('zh-CN')}
                  </span>
                  <span class="meta-pill">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
                      <path d="M6 3.5h9.5L19 7v13.5H6z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                      <path d="M15.5 3.5V7H19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                    {post.category}
                  </span>
                  <span class="meta-pill">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
                      <path d="M12 3v18M5 8h14M5 16h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                    </svg>
                    {post.tags.join(' / ') || '未分类'}
                  </span>
                </div>

                <p class="feed-card__excerpt">{post.description}</p>
                <div class="feed-card__foot">
                  {post.charCount} 字 | {post.readMinutes} 分钟
                </div>
              </div>
              <div class="feed-card__arrow" aria-hidden="true">›</div>
            </a>
          ))
        }
      </div>

      <p class="feed-empty" data-empty hidden>没有找到匹配的文章。</p>
    </div>
  </section>

  <script is:inline>
    (() => {
      const cards = Array.from(document.querySelectorAll('[data-post-card]'));
      const search = document.querySelector('[data-post-search]');
      const resultCount = document.querySelector('[data-result-count]');
      const empty = document.querySelector('[data-empty]');
      const categoryButtons = Array.from(document.querySelectorAll('[data-category-filter]'));
      const tagButtons = Array.from(document.querySelectorAll('[data-tag-filter]'));
      const clearFilters = document.querySelector('[data-clear-filters]');
      const animatedLists = Array.from(document.querySelectorAll('[data-animated-list]'));

      if (!cards.length || !search || !resultCount || !empty) return;

      const state = {
        query: '',
        category: 'all',
        tag: 'all'
      };

      function setActive(group, value) {
        group.forEach((item) => {
          item.classList.toggle('is-active', item.dataset.categoryFilter === value || item.dataset.tagFilter === value);
        });
      }

      function getVisibleItems(list) {
        return Array.from(list.children).filter((item) => !item.hidden);
      }

      function updateAnimatedList(list) {
        const rect = list.getBoundingClientRect();
        getVisibleItems(list).forEach((item) => {
          const itemRect = item.getBoundingClientRect();
          const itemCenter = itemRect.top + itemRect.height / 2;
          const inView = itemCenter >= rect.top - 16 && itemCenter <= rect.bottom + 16;
          item.classList.toggle('is-visible', inView);
        });
      }

      function updateAllAnimatedLists() {
        animatedLists.forEach(updateAnimatedList);
      }

      animatedLists.forEach((list) => {
        list.tabIndex = 0;
        list.addEventListener('scroll', () => window.requestAnimationFrame(() => updateAnimatedList(list)), {
          passive: true
        });

        getVisibleItems(list).forEach((item, index) => {
          item.dataset.index = String(index);
          item.addEventListener('mouseenter', () => {
            getVisibleItems(list).forEach((entry) => entry.classList.remove('is-selected'));
            item.classList.add('is-selected');
          });
          item.addEventListener('focus', () => {
            getVisibleItems(list).forEach((entry) => entry.classList.remove('is-selected'));
            item.classList.add('is-selected');
          });
        });

        list.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
          const items = getVisibleItems(list);
          if (!items.length) return;

          event.preventDefault();
          const activeIndex = Math.max(
            0,
            items.findIndex((item) => item === document.activeElement || item.classList.contains('is-selected'))
          );
          const nextIndex =
            event.key === 'ArrowDown' ? Math.min(activeIndex + 1, items.length - 1) : Math.max(activeIndex - 1, 0);
          const nextItem = items[nextIndex];
          items.forEach((item) => item.classList.remove('is-selected'));
          nextItem.classList.add('is-selected');
          nextItem.focus({ preventScroll: true });
          nextItem.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        });
      });

      function applyFilters() {
        const query = state.query.trim().toLowerCase();
        let visible = 0;

        cards.forEach((card) => {
          const title = (card.dataset.title ?? '').toLowerCase();
          const description = (card.dataset.description ?? '').toLowerCase();
          const category = card.dataset.category ?? '';
          const tags = (card.dataset.tags ?? '').split('|').filter(Boolean);
          const haystack = `${title} ${description} ${category} ${tags.join(' ')}`;
          const matchQuery = !query || haystack.includes(query);
          const matchCategory = state.category === 'all' || category === state.category;
          const matchTag = state.tag === 'all' || tags.includes(state.tag);
          const match = matchQuery && matchCategory && matchTag;

          card.hidden = !match;
          if (match) visible += 1;
        });

        resultCount.textContent = String(visible);
        empty.hidden = visible !== 0;
        window.requestAnimationFrame(updateAllAnimatedLists);
      }

      search.addEventListener('input', (event) => {
        state.query = event.target.value;
        search.closest('.search-box')?.classList.toggle('has-value', Boolean(state.query.trim()));
        applyFilters();
      });

      categoryButtons.forEach((button) => {
        button.addEventListener('click', () => {
          state.category = button.dataset.categoryFilter ?? 'all';
          state.tag = 'all';
          setActive(categoryButtons, state.category);
          tagButtons.forEach((item) => item.classList.remove('is-active'));
          applyFilters();
        });
      });

      tagButtons.forEach((button) => {
        button.addEventListener('click', () => {
          state.tag = button.dataset.tagFilter ?? 'all';
          state.category = 'all';
          setActive(tagButtons, state.tag);
          categoryButtons.forEach((item) => item.classList.toggle('is-active', item.dataset.categoryFilter === 'all'));
          applyFilters();
        });
      });

      clearFilters?.addEventListener('click', () => {
        state.query = '';
        state.category = 'all';
        state.tag = 'all';
        search.value = '';
        search.closest('.search-box')?.classList.remove('has-value');
        categoryButtons.forEach((item) => item.classList.toggle('is-active', item.dataset.categoryFilter === 'all'));
        tagButtons.forEach((item) => item.classList.remove('is-active'));
        applyFilters();
      });

      applyFilters();
      updateAllAnimatedLists();
    })();
  </script>
</BaseLayout>

<style>
  .home-hero {
    min-height: calc(100vh - 84px);
    padding: clamp(28px, 6vh, 58px) 0 44px;
    border-bottom: 0;
  }

  .article-hub {
    display: grid;
    grid-template-columns: minmax(240px, 280px) minmax(0, 820px);
    justify-content: center;
    gap: 22px;
    align-items: start;
    height: calc(100vh - 84px);
    min-height: 620px;
    overflow: hidden;
    padding: 42px 0;
    scroll-snap-align: start;
  }

  .sidebar {
    display: grid;
    gap: 16px;
    align-self: start;
  }

  .sidebar-card {
    display: grid;
    gap: 16px;
    border: 1px solid rgba(216, 227, 225, 0.68);
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.86), rgba(255, 255, 255, 0.66)),
      rgba(255, 255, 255, 0.72);
    box-shadow:
      0 18px 46px rgba(31, 53, 59, 0.08),
      0 0 0 1px rgba(255, 255, 255, 0.72) inset;
    padding: 16px;
    backdrop-filter: blur(16px) saturate(1.08);
  }

  .sidebar-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .sidebar-head h2 {
    margin: 0;
    font-size: 21px;
  }

  .reset-btn {
    border: 0;
    border-radius: 999px;
    background: rgba(15, 118, 110, 0.08);
    color: var(--accent);
    padding: 8px 12px;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }

  .category-list {
    display: grid;
    gap: 10px;
  }

  .animated-list {
    position: relative;
    overflow-y: auto;
    overscroll-behavior: contain;
    scroll-padding: 12px;
    scrollbar-width: none;
  }

  .animated-list::-webkit-scrollbar {
    display: none;
    width: 0;
  }

  .article-list.animated-list {
    scrollbar-width: thin;
    scrollbar-color: rgba(15, 118, 110, 0.72) rgba(255, 255, 255, 0.78);
  }

  .article-list.animated-list::-webkit-scrollbar {
    display: block;
    width: 12px;
  }

  .article-list.animated-list::-webkit-scrollbar-track {
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.78);
    box-shadow: inset 0 0 0 1px rgba(222, 216, 232, 0.82);
  }

  .article-list.animated-list::-webkit-scrollbar-thumb {
    border: 3px solid transparent;
    border-radius: 999px;
    background: rgba(15, 118, 110, 0.76);
    background-clip: padding-box;
  }

  .article-list.animated-list::-webkit-scrollbar-thumb:hover {
    background: rgba(15, 118, 110, 0.94);
    background-clip: padding-box;
  }

  .category-list.animated-list {
    max-height: calc((40px * 5) + (10px * 4));
    padding-right: 6px;
  }

  .category-item,
  .tag-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    border: 0;
    border-radius: 8px;
    background: transparent;
    padding: 10px 0;
    color: var(--text);
    font: inherit;
    text-align: left;
    cursor: pointer;
    opacity: 0;
    transform: scale(0.94);
    transform-origin: center;
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      background 160ms ease,
      color 160ms ease,
      border-color 160ms ease;
  }

  .category-item.is-visible,
  .tag-item.is-visible,
  .feed-card.is-visible {
    opacity: 1;
    transform: scale(1);
  }

  .category-item.is-selected,
  .tag-item.is-selected {
    color: var(--accent);
  }

  .category-item strong,
  .tag-item strong {
    min-width: 44px;
    border-radius: 8px;
    background: rgba(15, 118, 110, 0.08);
    color: var(--accent);
    padding: 7px 10px;
    text-align: center;
    font-size: 13px;
  }

  .category-item.is-active {
    color: var(--accent);
  }

  .tag-cloud {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .tag-item {
    width: 100%;
    justify-content: space-between;
    border: 1px solid rgba(216, 227, 225, 0.62);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.76), rgba(245, 248, 242, 0.72)),
      rgba(245, 248, 242, 0.78);
    padding: 9px 12px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.58) inset;
  }

  .tag-cloud.animated-list {
    max-height: calc((42px * 5) + (10px * 4));
    padding-right: 6px;
  }

  .tag-item strong {
    min-width: 0;
    padding: 4px 8px;
  }

  .feed {
    display: grid;
    gap: 16px;
    width: 100%;
    min-width: 0;
    align-self: start;
  }

  .feed-toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 50px;
    border: 1px solid rgba(216, 227, 225, 0.68);
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.68)),
      rgba(255, 255, 255, 0.72);
    padding: 0 14px;
    box-shadow:
      0 18px 46px rgba(31, 53, 59, 0.08),
      0 0 0 1px rgba(255, 255, 255, 0.72) inset;
    backdrop-filter: blur(16px) saturate(1.08);
    transition:
      border-color 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .search-box svg {
    width: 18px;
    height: 18px;
    color: var(--accent);
    flex: 0 0 auto;
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .search-box:focus-within,
  .search-box.has-value {
    border-color: rgba(15, 118, 110, 0.28);
    background:
      radial-gradient(circle at 20% 0%, rgba(15, 118, 110, 0.07), transparent 68%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.76));
    box-shadow:
      0 20px 48px rgba(31, 53, 59, 0.1),
      0 0 0 2px rgba(15, 118, 110, 0.055),
      0 0 0 1px rgba(255, 255, 255, 0.9) inset;
    transform: translateY(-1px);
  }

  .search-box:focus-within svg,
  .search-box.has-value svg {
    color: color-mix(in srgb, var(--accent) 78%, var(--text));
    transform: scale(1.08);
  }

  .search-box input {
    width: 100%;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 15px;
  }

  .feed-count {
    margin: 0;
    min-height: 50px;
    border: 1px solid rgba(222, 216, 232, 0.92);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.8);
    box-shadow: var(--shadow);
    padding: 12px 16px;
    color: var(--muted);
    font-size: 14px;
    white-space: nowrap;
    backdrop-filter: blur(18px) saturate(1.08);
  }

  .feed-count strong {
    color: var(--text);
    font-size: 20px;
  }

  .feed-list {
    display: grid;
    gap: 16px;
  }

  .article-list.animated-list {
    max-height: min(calc((190px * 5) + (16px * 4)), calc(100vh - 178px));
    padding: 2px 12px 2px 2px;
    scrollbar-gutter: stable;
  }

  .feed-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 58px;
    overflow: hidden;
    border: 1px solid rgba(222, 216, 232, 0.9);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: var(--shadow);
    min-height: 190px;
    opacity: 0;
    transform: scale(0.97);
    transform-origin: center;
    transition:
      opacity 200ms ease,
      transform 200ms ease,
      border-color 160ms ease;
  }

  .feed-card__body {
    display: grid;
    gap: 14px;
    padding: 20px 22px;
  }

  .feed-card__title {
    display: grid;
    grid-template-columns: 6px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
  }

  .feed-card__accent {
    width: 6px;
    height: 28px;
    border-radius: 999px;
    background: var(--accent);
    margin-top: 11px;
  }

  .feed-card__title h2 {
    margin: 0;
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(26px, 3.2vw, 38px);
    line-height: 1.08;
    font-weight: 900;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .meta-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 38px;
    border-radius: 8px;
    background: rgba(15, 118, 110, 0.08);
    color: var(--muted);
    padding: 0 12px;
    font-size: 13px;
  }

  .meta-pill svg {
    width: 18px;
    height: 18px;
    color: var(--accent);
    flex: 0 0 auto;
  }

  .feed-card__excerpt {
    max-width: 680px;
    margin: 0;
    color: var(--text);
    font-size: 16px;
    line-height: 1.7;
  }

  .feed-card__foot {
    color: #b0b0b0;
    font-size: 14px;
  }

  .feed-card__arrow {
    display: grid;
    place-items: center;
    background: rgba(15, 118, 110, 0.12);
    color: var(--accent);
    font-size: 42px;
    font-weight: 300;
  }

  .feed-card:hover {
    border-color: rgba(15, 118, 110, 0.2);
  }

  .feed-empty {
    margin: 8px 0 0;
    color: var(--muted);
    text-align: center;
  }

  .feed-card[hidden] {
    display: none;
  }

  .home-hero .hero-stack {
    gap: 16px;
  }

  .home-hero .hero-copy {
    max-width: 720px;
  }

  .scroll-hint {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 42px;
    border: 1px solid rgba(15, 118, 110, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.56);
    box-shadow:
      0 12px 32px rgba(31, 53, 59, 0.08),
      0 0 0 1px rgba(255, 255, 255, 0.72) inset;
    padding: 0 14px 0 16px;
    color: var(--muted);
