---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROJECTS } from '../data/projects';
---

<BaseLayout title="项目">
  <section class="hero" data-scene="0">
    <div class="hero-stack">
      <h1>做过的东西，和它们背后的判断。</h1>
      <p>展示开源项目、工具、应用和实验原型。比起只放链接，更适合写清楚目标、技术栈、难点和复盘文章。</p>
    </div>
    <aside class="hero-panel" aria-label="项目展示模板">
      <div class="terminal-bar"><span></span><span></span><span></span></div>
      <div class="terminal-body">
        <div><strong>格式：</strong> 名称 / 技术栈 / 复盘</div>
        <div><strong>链接：</strong> 仓库 / 演示 / 文章</div>
        <div><strong>目标：</strong> 展示判断，而不是堆砌信息</div>
      </div>
    </aside>
  </section>

  <section class="section archive-section" aria-labelledby="projects-grid" data-scene="2">
    <div class="section-heading">
      <h2 id="projects-grid">项目档案</h2>
    </div>
    <div class="archive-panel project-archive" aria-label="项目列表">
      <div class="project-grid">
        {
          PROJECTS.map((project) => (
            <article class="info-card project-card">
              <div class="project-card__top">
                <div>
                  <h2>{project.name}</h2>
                  <p>{project.summary}</p>
                </div>
                <span class="project-status">{project.status}</span>
              </div>
              <div class="tags project-tags">
                {project.stack.map((item: string) => <span>{item}</span>)}
              </div>
              <div class="project-links">
                {project.links.map((link) => (
                  <a href={link.href}>{link.label}</a>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
