---
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hang's Blog Admin</title>
  </head>
  <body>
    <noscript>Decap CMS needs JavaScript enabled.</noscript>

    <script is:inline>
      window.CMS_MANUAL_INIT = true;
      window.DECAP_CMS_CONFIG = {
        backend: {
          name: 'github',
          repo: 'sirius868/personal_blog',
          branch: 'main',
          base_url: location.origin,
          auth_endpoint: 'api/auth'
        },
        load_config_file: false,
        locale: 'zh_hans',
        local_backend: location.hostname === '127.0.0.1' || location.hostname === 'localhost',
        media_folder: 'public/uploads',
        public_folder: '/uploads',
        logo_url: '/brand-mark.png',
        collections: [
          {
            name: 'posts',
            label: '文章',
            label_singular: '文章',
            folder: 'src/content/posts',
            create: true,
            delete: true,
            extension: 'md',
            format: 'frontmatter',
            slug: '{{slug}}',
            summary: '{{title}} - {{pubDate}}',
            preview_path: 'posts/{{slug}}/',
            editor: {
              preview: false
            },
            view_filters: [
              { label: '已发布', field: 'draft', pattern: false },
              { label: '草稿', field: 'draft', pattern: true }
            ],
            view_groups: [
              { label: '标签', field: 'tags' }
            ],
            fields: [
              { label: '标题', name: 'title', widget: 'string' },
              { label: '摘要', name: 'description', widget: 'text' },
              { label: '发布日期', name: 'pubDate', widget: 'date', format: 'YYYY-MM-DD' },
              { label: '更新日期', name: 'updatedDate', widget: 'date', format: 'YYYY-MM-DD', required: false },
              {
                label: '标签',
                name: 'tags',
                widget: 'list',
                collapsed: false,
                field: { label: '标签', name: 'tag', widget: 'string' }
              },
              { label: '草稿', name: 'draft', widget: 'boolean', default: false, required: false },
              { label: '正文', name: 'body', widget: 'markdown' }
            ]
          },
          {
            name: 'projects',
            label: '项目',
            label_singular: '项目',
            folder: 'src/content/projects',
            create: true,
            delete: true,
            extension: 'md',
            format: 'frontmatter',
            slug: '{{slug}}',
            summary: '{{name}} - {{status}}',
            preview_path: 'projects/',
            editor: {
              preview: false
            },
            view_filters: [
              { label: '已发布', field: 'draft', pattern: false },
              { label: '草稿', field: 'draft', pattern: true }
            ],
            view_groups: [
              { label: '状态', field: 'status' }
            ],
            fields: [
              { label: '名称', name: 'name', widget: 'string' },
              { label: '摘要', name: 'summary', widget: 'text' },
              {
                label: '状态',
                name: 'status',
                widget: 'select',
                options: ['Active', 'Ongoing', 'Planned', 'Archived'],
                default: 'Active'
              },
              {
                label: '排序',
                name: 'order',
                widget: 'number',
                value_type: 'int',
                default: 0,
                hint: '数字越小越靠前。'
              },
              {
                label: '技术栈',
                name: 'stack',
                widget: 'list',
                collapsed: false,
                field: { label: '技术', name: 'item', widget: 'string' }
              },
              {
                label: '链接',
                name: 'links',
                widget: 'list',
                collapsed: false,
                fields: [
                  { label: '名称', name: 'label', widget: 'string' },
                  { label: 'URL', name: 'href', widget: 'string' }
                ]
              },
              { label: '草稿', name: 'draft', widget: 'boolean', default: false, required: false },
              { label: '备注', name: 'body', widget: 'markdown', required: false }
            ]
          }
        ]
      };
    </script>
    <script>
      (async () => {
        const { default: CMS } = await import('decap-cms-app');
        const { default: zhHans } = await import('decap-cms-locales/dist/esm/zh_Hans/index.js');
        CMS.registerLocale('zh_hans', zhHans);
        type InitOptions = Parameters<typeof CMS.init>[0];
        const config = (window as unknown as { DECAP_CMS_CONFIG: InitOptions extends { config?: infer C } ? C : never })
          .DECAP_CMS_CONFIG;
        CMS.init({ config });
      })();
    </script>
  </body>
</html>

<style>
  body {
    margin: 0;
    font-family: Inter, system-ui, sans-serif;
  }

  #nc-root,
  #nc-root button,
  #nc-root input,
  #nc-root select,
  #nc-root textarea {
    font-family: "Noto Sans SC", "Microsoft YaHei", Inter, system-ui, sans-serif;
  }

  #nc-root a {
    color: #0f766e;
  }

  #nc-root button {
    border-radius: 6px;
  }

  #nc-root input,
  #nc-root select,
  #nc-root textarea {
    border-radius: 6px;
  }

  #nc-root *::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }

  #nc-root *::-webkit-scrollbar-track {
    background: rgba(246, 244, 239, 0.6);
    border-radius: 999px;
  }

  #nc-root *::-webkit-scrollbar-thumb {
    border: 2px solid transparent;
    border-radius: 999px;
    background: rgba(15, 118, 110, 0.32);
    background-clip: padding-box;
  }

  #nc-root *::-webkit-scrollbar-thumb:hover {
    background: rgba(15, 118, 110, 0.5);
    background-clip: padding-box;
  }
</style>
