---
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hang's Blog Admin</title>
  </head>
  <body>
    <div class="local-cms-note" data-local-cms-note hidden>
      <strong>本地编辑需要先启动 CMS 后端</strong>
      <span>另开一个终端运行 npm.cmd run cms，再刷新这个页面。线上部署到 Vercel 后会使用 GitHub 授权登录。</span>
    </div>

    <script>
      import CMS from 'decap-cms-app';

      const isLocal = location.hostname === '127.0.0.1' || location.hostname === 'localhost';

      if (isLocal) {
        document.querySelector('[data-local-cms-note]')?.removeAttribute('hidden');
      }

      const config = {
          backend: {
            name: 'github',
            repo: 'sirius868/personal_blog',
            branch: 'main',
            base_url: location.origin,
            auth_endpoint: 'api/auth'
          },
          local_backend: isLocal,
          media_folder: 'public/uploads',
          public_folder: '/uploads',
          logo_url: '/brand-mark.png',
          collections: [
            {
              name: 'posts',
              label: '文章',
              label_singular: '文章',
              folder: 'src/content/posts',
              create: true,
              delete: true,
              extension: 'md',
              format: 'frontmatter',
              slug: '{{slug}}',
              preview_path: 'posts/{{slug}}/',
              editor: {
                preview: false
              },
              fields: [
                { label: '标题', name: 'title', widget: 'string' },
                { label: '摘要', name: 'description', widget: 'text' },
                { label: '发布日期', name: 'pubDate', widget: 'date', format: 'YYYY-MM-DD' },
                { label: '更新日期', name: 'updatedDate', widget: 'date', format: 'YYYY-MM-DD', required: false },
                {
                  label: '标签',
                  name: 'tags',
                  widget: 'list',
                  collapsed: false,
                  field: { label: '标签', name: 'tag', widget: 'string' }
                },
                { label: '草稿', name: 'draft', widget: 'boolean', default: false, required: false },
                { label: '正文', name: 'body', widget: 'markdown' }
              ]
            }
          ]
      };

      CMS.init({ config: config as any });
    </script>
  </body>
</html>

<style>
  body {
    margin: 0;
    font-family: Inter, system-ui, sans-serif;
  }

  .local-cms-note {
    position: fixed;
    top: 16px;
    left: 50%;
    z-index: 10;
    display: grid;
    gap: 4px;
    width: min(560px, calc(100% - 32px));
    border: 1px solid rgba(15, 118, 110, 0.18);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 18px 48px rgba(31, 53, 59, 0.14);
    padding: 12px 14px;
    color: #1d1b22;
    transform: translateX(-50%);
  }

  .local-cms-note strong {
    font-size: 14px;
  }

  .local-cms-note span {
    color: #66737a;
    font-size: 13px;
    line-height: 1.5;
  }
</style>
