---
import { ViewTransitions } from 'astro:transitions';
import DotGrid from '../components/DotGrid.astro';
import { AUTHOR_ROLE, REPO_URL, SITE_DESCRIPTION, SITE_NAV, SITE_TITLE } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN" data-path={pathname}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={base + 'brand-mark.png'} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={base + 'rss.xml'} />
    <title>{pageTitle}</title>
    <ViewTransitions />
  </head>
  <body>
    <DotGrid
      dotSize={4}
      gap={38}
      baseColor="#0f766e"
      activeColor="#0f766e"
      proximity={150}
      speedTrigger={90}
      shockRadius={260}
      shockStrength={4}
      resistance={750}
      returnDuration={1.5}
    />
    <canvas id="click-spark-field" aria-hidden="true" transition:persist="spark-field"></canvas>
    <header class="site-header">
      <a class="brand" href={base || '/'} aria-label={SITE_TITLE}>
        <span class="brand-mark">
          <img src={base + 'brand-mark.png'} alt="" width="40" height="40" />
        </span>
        <span class="brand-copy">
          <strong>{SITE_TITLE}</strong>
          <small>{AUTHOR_ROLE}</small>
        </span>
      </a>
      <a class="github-link" href={REPO_URL} target="_blank" rel="noreferrer" aria-label="GitHub 仓库">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.48 0-.24-.01-.88-.01-1.73-2.79.62-3.38-1.38-3.38-1.38-.46-1.19-1.12-1.5-1.12-1.5-.92-.64.07-.62.07-.62 1.02.07 1.56 1.07 1.56 1.07.9 1.58 2.37 1.12 2.95.86.09-.67.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.08 0-1.12.38-2.03 1-2.75-.1-.27-.44-1.37.1-2.86 0 0 .83-.27 2.74 1.05a9.2 9.2 0 0 1 2.5-.35c.85 0 1.7.12 2.5.35 1.9-1.32 2.73-1.05 2.73-1.05.55 1.49.2 2.59.1 2.86.62.72 1 1.63 1 2.75 0 3.95-2.34 4.82-4.57 5.07.36.32.67.95.67 1.92 0 1.39-.01 2.51-.01 2.85 0 .26.18.58.69.48A10.28 10.28 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z" fill="currentColor"></path>
        </svg>
        <span>GitHub</span>
      </a>
      <nav aria-label="主导航">
        {
          SITE_NAV.map((item) => (
            <a class:list={[pathname === item.href && 'active']} href={item.href}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <script is:inline>
      (() => {
        const sparkCanvas = document.getElementById('click-spark-field');
        const sparkCtx = sparkCanvas instanceof HTMLCanvasElement ? sparkCanvas.getContext('2d') : null;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        if (!sparkCanvas || !sparkCtx || reduceMotion.matches) return;

        let width = 0;
        let height = 0;
        let dpr = 1;
        let sparks = [];
        let frame = 0;

        const config = {
          color: 'rgba(17, 17, 17, 0.62)',
          count: 7,
          size: 9,
          radius: 20,
          duration: 360,
          lineWidth: 1.6
        };

        function resizeSparkCanvas() {
          dpr = Math.min(window.devicePixelRatio || 1, 3);
          width = window.innerWidth;
          height = window.innerHeight;
          sparkCanvas.width = Math.floor(width * dpr);
          sparkCanvas.height = Math.floor(height * dpr);
          sparkCanvas.style.width = `${width}px`;
          sparkCanvas.style.height = `${height}px`;
          sparkCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }

        function addSpark(event) {
          const now = performance.now();
          for (let i = 0; i < config.count; i += 1) {
            sparks.push({
              x: event.clientX,
              y: event.clientY,
              angle: (Math.PI * 2 * i) / config.count,
              start: now
            });
          }
        }

        function easeOut(value) {
          return value * (2 - value);
        }

        function drawSparks(now) {
          sparkCtx.clearRect(0, 0, width, height);
          sparks = sparks.filter((spark) => {
            const progress = Math.min(1, (now - spark.start) / config.duration);
            if (progress >= 1) return false;

            const eased = easeOut(progress);
            const distance = eased * config.radius;
            const lineLength = config.size * (1 - eased);
            const x1 = spark.x + distance * Math.cos(spark.angle);
            const y1 = spark.y + distance * Math.sin(spark.angle);
            const x2 = spark.x + (distance + lineLength) * Math.cos(spark.angle);
            const y2 = spark.y + (distance + lineLength) * Math.sin(spark.angle);

            sparkCtx.globalAlpha = 1 - progress;
            sparkCtx.strokeStyle = config.color;
            sparkCtx.lineWidth = config.lineWidth;
            sparkCtx.lineCap = 'round';
            sparkCtx.beginPath();
            sparkCtx.moveTo(x1, y1);
            sparkCtx.lineTo(x2, y2);
            sparkCtx.stroke();
            return true;
          });

          sparkCtx.globalAlpha = 1;
          frame = requestAnimationFrame(drawSparks);
        }

        resizeSparkCanvas();
        window.addEventListener('resize', resizeSparkCanvas, { passive: true });
        window.addEventListener('pointerdown', addSpark, { passive: true });
        frame = requestAnimationFrame(drawSparks);
        window.addEventListener(
          'beforeunload',
          () => {
            cancelAnimationFrame(frame);
          },
          { once: true }
        );
      })();
    </script>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;600;700&family=Noto+Serif+SC:wght@600;700;800;900&display=swap');

  :root {
    color-scheme: light;
    --bg: #f6f4ef;
    --panel: #ffffff;
    --panel-2: #edf4f3;
    --text: #1d1b22;
    --muted: #66737a;
    --faint: #8b969b;
    --line: #d8e3e1;
    --accent: #0f766e;
    --accent-2: #0e7490;
    --danger: #d95555;
    --shadow: 0 24px 80px rgba(31, 53, 59, 0.12);
    --font-display: "Noto Serif SC", "Source Han Serif SC", "Songti SC", serif;
    --font-body: Inter, "Noto Sans SC", "Microsoft YaHei", system-ui, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
    font-family: var(--font-body);
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
    overflow-x: clip;
    scroll-behavior: smooth;
    scroll-padding-top: 84px;
  }

  html[data-path="/"],
  html[data-path="/about/"],
  html[data-path="/projects/"] {
    scroll-snap-type: y mandatory;
  }

  body {
    position: relative;
    margin: 0;
    width: 100%;
    max-width: 100%;
    min-height: 100vh;
    overflow-x: hidden;
    overflow-x: clip;
    background:
      radial-gradient(circle at 50% -8%, rgba(253, 224, 71, 0.12), transparent 30rem),
      radial-gradient(circle at 12% 22%, rgba(255, 255, 255, 0.78), transparent 24rem),
      linear-gradient(145deg, rgba(255, 255, 255, 0.88), rgba(237, 244, 243, 0.66) 44%, rgba(246, 244, 239, 0.98)),
      var(--bg);
    color: var(--text);
    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
  }

  body::before {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    content: "";
    background-image:
      linear-gradient(rgba(15, 118, 110, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(100, 116, 139, 0.035) 1px, transparent 1px);
    background-size: 54px 54px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.56), transparent 76%);
  }

  #click-spark-field {
    position: fixed;
    inset: 0;
    z-index: 20;
    max-width: 100vw;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #ambient-field,
    #click-spark-field {
      display: none;
    }
  }

  ::view-transition-old(root) {
    animation: 170ms ease both vt-fade-out;
  }

  ::view-transition-new(root) {
    animation: 300ms cubic-bezier(0.22, 1, 0.36, 1) both vt-fade-in;
  }

  @keyframes vt-fade-out {
    to {
      opacity: 0;
    }
  }

  @keyframes vt-fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
    }
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  main,
  .site-header {
    position: relative;
    z-index: 2;
    width: min(1120px, calc(100% - 32px));
    max-width: 100%;
    margin: 0 auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 0;
    isolation: isolate;
  }

  .site-header::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    z-index: -1;
    width: 100vw;
    border-bottom: 1px solid rgba(222, 216, 232, 0.82);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.76), rgba(255, 255, 255, 0.48)),
      rgba(246, 244, 239, 0.72);
    box-shadow: 0 18px 44px rgba(31, 53, 59, 0.08);
    backdrop-filter: blur(20px) saturate(1.12);
    transform: translateX(-50%);
    content: "";
  }

  .site-header > * {
    position: relative;
    z-index: 1;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    gap: 12px;
  }

  .brand-mark {
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
    display: block;
    overflow: hidden;
    border-radius: 0;
  }

  .brand-mark img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 8px 16px rgba(31, 53, 59, 0.16));
  }

  .brand-copy {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .brand-copy strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 800;
  }

  .brand-copy small {
    color: var(--muted);
    font-size: 12px;
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    border: 1px solid rgba(222, 216, 232, 0.95);
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.84), rgba(255, 255, 255, 0.58));
    padding: 0 13px 0 11px;
    color: var(--text);
    font-size: 13px;
    font-weight: 700;
    box-shadow: 0 10px 24px rgba(31, 53, 59, 0.08);
  }

  .github-link svg {
    width: 16px;
    height: 16px;
  }

  .github-link:hover {
    border-color: rgba(15, 118, 110, 0.24);
    color: var(--accent);
  }

  nav {
    position: relative;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border: 1px solid rgba(222, 216, 232, 0.9);
    border-radius: 10px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.58)),
      rgba(246, 244, 239, 0.72);
    box-shadow:
      0 14px 34px rgba(31, 53, 59, 0.1),
      0 0 0 1px rgba(255, 255, 255, 0.82) inset;
    color: var(--muted);
    font-size: 14px;
    overflow: hidden;
    isolation: isolate;
  }

  nav a {
    position: relative;
    z-index: 1;
    min-height: 32px;
    padding: 7px 13px;
    border-radius: 7px;
    border: 1px solid transparent;
    color: var(--muted);
    transition:
      border-color 160ms ease,
      background 160ms ease,
      box-shadow 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  nav a:hover {
    border-color: rgba(15, 118, 110, 0.16);
    background: rgba(15, 118, 110, 0.06);
    color: var(--text);
    transform: translateY(-1px);
  }

  nav a.active {
    border-color: rgba(15, 118, 110, 0.22);
    background:
      radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.64), transparent 62%),
      linear-gradient(180deg, rgba(15, 118, 110, 0.13), rgba(14, 116, 144, 0.06)),
      rgba(255, 255, 255, 0.9);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.9) inset,
      0 10px 22px rgba(15, 118, 110, 0.14);
    color: var(--text);
    transform: translateY(-1px);
  }

  h1,
  h2,
  h3,
  p {
    overflow-wrap: anywhere;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: 0;
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    align-content: center;
    justify-items: center;
    gap: clamp(42px, 7vh, 78px);
    min-height: calc(100vh - 84px);
    padding: clamp(28px, 6vh, 58px) 0 44px;
    border-bottom: 1px solid var(--line);
  }

  .about-hero::before {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: min(960px, calc(100% + 10px));
    height: min(540px, calc(100% - 56px));
    border: 1px solid rgba(222, 216, 232, 0.9);
    border-radius: 10px;
    background:
      radial-gradient(circle at 50% 0%, rgba(15, 118, 110, 0.08), transparent 24rem),
      linear-gradient(180deg, rgba(255, 255, 255, 0.74), rgba(255, 255, 255, 0.54));
    box-shadow:
      0 28px 90px rgba(31, 53, 59, 0.14),
      0 0 0 1px rgba(255, 255, 255, 0.72) inset;
    backdrop-filter: blur(20px) saturate(1.12);
    transform: translate(-50%, -50%);
    content: "";
  }

  .about-hero .hero-stack {
    max-width: 760px;
  }

  .about-hero .hero-panel {
    width: min(620px, 100%);
  }

  html[data-path="/"] .hero,
  html[data-path="/about/"] .hero,
  html[data-path="/projects/"] .hero {
    scroll-snap-align: start;
  }

  .hero-stack,
  .hero-panel {
    position: relative;
    z-index: 2;
  }

  .hero-stack {
    display: grid;
    justify-items: center;
    gap: 24px;
    width: min(920px, 100%);
    margin-top: -4vh;
    text-align: center;
  }

  .hero-title {
    display: grid;
    justify-items: center;
    gap: clamp(26px, 4vh, 42px);
    padding-bottom: 6px;
  }

  .hero-kicker {
    max-width: min(920px, 100%);
    margin: 0;
    font-size: clamp(26px, 3vw, 42px);
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1.12;
    color: color-mix(in srgb, var(--text) 92%, var(--accent));
    text-shadow: 0 12px 38px rgba(15, 118, 110, 0.12);
    text-wrap: balance;
  }

  .eyebrow {
    margin: 0;
    color: var(--accent);
    font: 800 12px/1.2 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    max-width: 800px;
    margin: 0;
    font-size: clamp(42px, 6vw, 76px);
    line-height: 1;
  }

  .hero-copy,
  .page-intro {
    max-width: 680px;
    margin: 0;
    color: var(--muted);
    font-size: clamp(16px, 1.7vw, 18px);
    line-height: 1.78;
    text-wrap: balance;
  }

  .hero-copy {
    margin-top: 4px;
  }

  .hero-dashboard {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
    gap: 16px;
    align-items: stretch;
    width: min(900px, 100%);
  }

  .hero-panel,
  .post-card,
  .stat,
  .info-card {
    border: 1px solid rgba(222, 216, 232, 0.9);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.68);
    box-shadow: var(--shadow);
    backdrop-filter: blur(18px) saturate(1.08);
  }

  .terminal-bar {
    display: flex;
    gap: 7px;
    padding: 13px 14px;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.42);
  }

  .terminal-bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--danger);
  }

  .terminal-bar span:nth-child(2) {
    background: var(--accent-2);
  }

  .terminal-bar span:nth-child(3) {
    background: var(--accent);
  }

  .terminal-body {
    display: grid;
    gap: 12px;
    padding: 20px;
    color: var(--muted);
    font: 14px/1.65 var(--font-mono);
  }

  .terminal-body strong {
    color: var(--text);
  }

  .prompt {
    color: var(--accent);
  }

  .section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100vh - 84px);
    padding: 42px 0;
  }

  .archive-section {
    height: calc(100vh - 84px);
    min-height: 620px;
    justify-content: center;
    overflow: hidden;
  }

  html[data-path="/"] .section,
  html[data-path="/about/"] .section,
  html[data-path="/projects/"] .section {
    scroll-snap-align: start;
  }

  .section.grid {
    display: grid;
    align-content: center;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 18px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 26px;
  }

  .section-heading p {
    max-width: 520px;
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .archive-panel {
    overflow: auto;
    max-height: min(68vh, 680px);
    border: 1px solid rgba(222, 216, 232, 0.9);
    border-radius: 10px;
    background:
      radial-gradient(circle at 50% 0%, rgba(15, 118, 110, 0.08), transparent 20rem),
      linear-gradient(180deg, rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0.58));
    box-shadow:
      0 24px 70px rgba(31, 53, 59, 0.13),
      0 0 0 1px rgba(255, 255, 255, 0.76) inset;
    padding: 16px;
    backdrop-filter: blur(18px) saturate(1.12);
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgba(15, 118, 110, 0.28) rgba(255, 255, 255, 0.62);
  }

  .archive-panel::-webkit-scrollbar {
    width: 10px;
  }

  .archive-panel::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.62);
    border-radius: 999px;
  }

  .archive-panel::-webkit-scrollbar-thumb {
    border: 2px solid transparent;
    border-radius: 999px;
    background: rgba(15, 118, 110, 0.3);
    background-clip: padding-box;
  }

  .post-list {
    display: grid;
    gap: 12px;
    padding: 0;
    list-style: none;
  }

  .post-card {
    transition: none;
  }

  .post-link {
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: 18px 22px;
    text-align: center;
  }

  .post-date {
    color: var(--faint);
    font: 700 13px/1.3 var(--font-mono);
  }

  .post-link h2 {
    margin: 0 0 8px;
    font-size: clamp(21px, 3vw, 28px);
    line-height: 1.18;
  }

  .post-link:hover h2 {
    color: var(--accent);
  }

  .meta,
  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    color: var(--muted);
    font-size: 14px;
  }

  .tags span {
    border: 1px solid rgba(15, 118, 110, 0.2);
    border-radius: 999px;
    padding: 4px 9px;
    color: var(--accent);
    background: rgba(15, 118, 110, 0.055);
    font-size: 13px;
  }

  .post-description {
    max-width: 680px;
    margin: 0 0 12px;
    color: var(--muted);
    line-height: 1.7;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    height: 100%;
  }

  .stat,
  .info-card {
    padding: 18px;
  }

  .project-card {
    display: grid;
    gap: 12px;
    min-height: 190px;
    align-content: start;
  }

  .project-card__top {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 18px;
  }

  .project-card__top h2 {
    margin: 0 0 8px;
    font-size: 22px;
  }

  .project-card__top p {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .project-status {
    flex: 0 0 auto;
    align-self: start;
    border: 1px solid rgba(15, 118, 110, 0.2);
    border-radius: 999px;
    padding: 5px 9px;
    color: var(--accent);
    background: rgba(15, 118, 110, 0.06);
