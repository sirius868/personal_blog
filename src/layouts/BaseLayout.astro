---
import { AUTHOR_ROLE, SITE_DESCRIPTION, SITE_NAV, SITE_TITLE } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN" data-path={pathname}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/brand-mark.png" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <canvas id="ambient-field" aria-hidden="true"></canvas>
    <header class="site-header">
      <a class="brand" href="/" aria-label={SITE_TITLE}>
        <span class="brand-mark">
          <img src="/brand-mark.png" alt="" width="40" height="40" />
        </span>
        <span class="brand-copy">
          <strong>{SITE_TITLE}</strong>
          <small>{AUTHOR_ROLE}</small>
        </span>
      </a>
      <nav aria-label="主导航">
        {
          SITE_NAV.map((item) => (
            <a class:list={[pathname === item.href && 'active']} href={item.href}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <script is:inline>
      const canvas = document.getElementById('ambient-field');
      const ctx = canvas instanceof HTMLCanvasElement ? canvas.getContext('2d') : null;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (canvas && ctx && !reduceMotion.matches) {
        const colors = [
          'rgba(167, 139, 250, 0.42)',
          'rgba(216, 180, 254, 0.26)',
          'rgba(129, 140, 248, 0.2)'
        ];
        const pointer = {
          x: window.innerWidth * 0.62,
          y: window.innerHeight * 0.34,
          px: window.innerWidth * 0.62,
          py: window.innerHeight * 0.34,
          vx: 0,
          vy: 0,
          active: false
        };

        let width = 0;
        let height = 0;
        let dpr = 1;
        let frame = 0;
        let particles = [];

        function resize() {
          dpr = Math.min(window.devicePixelRatio || 1, 2.75);
          width = window.innerWidth;
          height = window.innerHeight;
          canvas.width = Math.floor(width * dpr);
          canvas.height = Math.floor(height * dpr);
          canvas.style.width = `${width}px`;
          canvas.style.height = `${height}px`;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

          const count = Math.min(260, Math.max(120, Math.floor((width * height) / 7200)));
          particles = Array.from({ length: count }, (_, index) => ({
            x: Math.random() * width,
            y: Math.random() * height,
            vx: 0,
            vy: 0,
            radius: 1.2 + Math.random() * 3.6,
            halo: 12 + Math.random() * 34,
            hue: index % colors.length,
            phase: Math.random() * Math.PI * 2
          }));
        }

        function stir(event) {
          pointer.px = pointer.x;
          pointer.py = pointer.y;
          pointer.x = event.clientX;
          pointer.y = event.clientY;
          pointer.vx = pointer.x - pointer.px;
          pointer.vy = pointer.y - pointer.py;
          pointer.active = true;
        }

        function settlePointer() {
          pointer.active = false;
        }

        function render() {
          frame += 0.0038;
          ctx.globalCompositeOperation = 'source-over';
          ctx.fillStyle = 'rgba(7, 7, 17, 0.2)';
          ctx.fillRect(0, 0, width, height);
          ctx.globalCompositeOperation = 'lighter';

          const idleX = width * (0.58 + Math.sin(frame * 0.62) * 0.07);
          const idleY = height * (0.42 + Math.cos(frame * 0.48) * 0.06);
          const attractX = pointer.active ? pointer.x : idleX;
          const attractY = pointer.active ? pointer.y : idleY;

          for (const p of particles) {
            const dx = p.x - attractX;
            const dy = p.y - attractY;
            const distance = Math.hypot(dx, dy) || 1;
            const influence = Math.max(0, 1 - distance / 520);
            const swirl = Math.sin(frame * 1.35 + p.phase + distance * 0.008) * 0.1;

            p.vx += -dy / distance * influence * 0.026 + pointer.vx * influence * 0.0012;
            p.vy += dx / distance * influence * 0.026 + pointer.vy * influence * 0.0012;
            p.vx += Math.sin(frame + p.phase) * 0.0025 + swirl * 0.0025;
            p.vy += Math.cos(frame * 0.9 + p.phase) * 0.0025 - swirl * 0.0025;
            p.vx *= 0.962;
            p.vy *= 0.962;
            p.x += p.vx;
            p.y += p.vy;

            if (p.x < -180) p.x = width + 180;
            if (p.x > width + 180) p.x = -180;
            if (p.y < -180) p.y = height + 180;
            if (p.y > height + 180) p.y = -180;

            const gradient = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.halo);
            gradient.addColorStop(0, colors[p.hue]);
            gradient.addColorStop(0.28, colors[p.hue].replace(/0\.\d+\)/, '0.075)'));
            gradient.addColorStop(1, 'rgba(7, 7, 17, 0)');
            ctx.fillStyle = gradient;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.halo, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = colors[p.hue].replace(/0\.\d+\)/, '0.72)');
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
            ctx.fill();
          }

          pointer.vx *= 0.62;
          pointer.vy *= 0.62;
          requestAnimationFrame(render);
        }

        resize();
        window.addEventListener('resize', resize, { passive: true });
        window.addEventListener('pointermove', stir, { passive: true });
        window.addEventListener('pointerdown', stir, { passive: true });
        window.addEventListener('pointerup', settlePointer, { passive: true });
        window.addEventListener('pointerleave', settlePointer, { passive: true });
        requestAnimationFrame(render);
      }
    </script>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;600;700&family=Noto+Serif+SC:wght@600;700;800;900&display=swap');

  :root {
    color-scheme: dark;
    --bg: #070711;
    --panel: #111020;
    --panel-2: #18162b;
    --text: #eef2f5;
    --muted: #9ca8b4;
    --faint: #66727f;
    --line: #29243f;
    --accent: #a78bfa;
    --accent-2: #d8b4fe;
    --danger: #ff8d8d;
    --shadow: 0 22px 80px rgba(0, 0, 0, 0.22);
    --font-display: "Noto Serif SC", "Source Han Serif SC", "Songti SC", serif;
    --font-body: Inter, "Noto Sans SC", "Microsoft YaHei", system-ui, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
    font-family: var(--font-body);
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    scroll-behavior: smooth;
    scroll-padding-top: 84px;
  }

  html[data-path="/"] {
    scroll-snap-type: y mandatory;
  }

  body {
    position: relative;
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at 50% 0%, rgba(167, 139, 250, 0.1), transparent 28rem),
      linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 22rem),
      var(--bg);
    color: var(--text);
    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
  }

  body::before {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    content: "";
    background-image:
      linear-gradient(rgba(167, 139, 250, 0.026) 1px, transparent 1px),
      linear-gradient(90deg, rgba(216, 180, 254, 0.018) 1px, transparent 1px);
    background-size: 52px 52px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.78), transparent 74%);
  }

  #ambient-field {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    filter: saturate(1.08);
    opacity: 0.82;
  }

  @media (prefers-reduced-motion: reduce) {
    #ambient-field {
      display: none;
    }
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  main,
  .site-header {
    position: relative;
    z-index: 2;
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 0;
    isolation: isolate;
  }

  .site-header::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    z-index: -1;
    width: 100vw;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background:
      linear-gradient(180deg, rgba(12, 11, 25, 0.84), rgba(12, 11, 25, 0.52)),
      rgba(7, 7, 17, 0.58);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.16);
    backdrop-filter: blur(18px) saturate(1.18);
    transform: translateX(-50%);
    content: "";
  }

  .site-header > * {
    position: relative;
    z-index: 1;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    gap: 12px;
  }

  .brand-mark {
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
    display: block;
    overflow: hidden;
    border-radius: 0;
  }

  .brand-mark img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 0 8px rgba(216, 180, 254, 0.36));
  }

  .brand-copy {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .brand-copy strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 800;
  }

  .brand-copy small {
    color: var(--muted);
    font-size: 12px;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    background: rgba(12, 11, 25, 0.72);
    box-shadow:
      0 10px 28px rgba(0, 0, 0, 0.18),
      0 0 0 1px rgba(167, 139, 250, 0.05) inset;
    color: var(--muted);
    font-size: 14px;
  }

  nav a {
    min-height: 32px;
    padding: 7px 11px;
    border-radius: 6px;
    border: 1px solid transparent;
    transition:
      border-color 160ms ease,
      background 160ms ease,
      box-shadow 160ms ease,
      color 160ms ease;
  }

  nav a:hover {
    border-color: rgba(216, 180, 254, 0.26);
    background: rgba(255, 255, 255, 0.06);
    color: #f8fff9;
  }

  nav a.active {
    border-color: rgba(216, 180, 254, 0.62);
    background:
      linear-gradient(180deg, rgba(216, 180, 254, 0.17), rgba(167, 139, 250, 0.1)),
      rgba(24, 22, 43, 0.96);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08) inset,
      0 8px 24px rgba(167, 139, 250, 0.15);
    color: #ffffff;
  }

  h1,
  h2,
  h3,
  p {
    overflow-wrap: anywhere;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: 0;
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    align-content: center;
    justify-items: center;
    gap: clamp(42px, 7vh, 78px);
    min-height: calc(100vh - 84px);
    padding: clamp(28px, 6vh, 58px) 0 44px;
    border-bottom: 1px solid var(--line);
  }

  .about-hero::before {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: min(960px, calc(100% + 10px));
    height: min(540px, calc(100% - 56px));
    border: 1px solid rgba(216, 180, 254, 0.18);
    border-radius: 8px;
    background:
      radial-gradient(circle at 50% 0%, rgba(167, 139, 250, 0.11), transparent 24rem),
      linear-gradient(180deg, rgba(18, 16, 34, 0.8), rgba(10, 9, 22, 0.6));
    box-shadow:
      0 28px 90px rgba(0, 0, 0, 0.28),
      0 0 0 1px rgba(255, 255, 255, 0.035) inset;
    backdrop-filter: blur(20px) saturate(1.18);
    transform: translate(-50%, -50%);
    content: "";
  }

  .about-hero .hero-stack {
    max-width: 760px;
  }

  .about-hero .hero-panel {
    width: min(620px, 100%);
  }

  html[data-path="/"] .hero {
    scroll-snap-align: start;
  }

  .hero-stack,
  .hero-panel {
    position: relative;
    z-index: 2;
  }

  .hero-stack {
    display: grid;
    justify-items: center;
    gap: 24px;
    width: min(920px, 100%);
    margin-top: -4vh;
    text-align: center;
  }

  .hero-title {
    display: grid;
    justify-items: center;
    gap: clamp(26px, 4vh, 42px);
    padding-bottom: 6px;
  }

  .hero-kicker {
    max-width: 760px;
    margin: 0;
    font-size: clamp(28px, 3.4vw, 46px);
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1.12;
    color: color-mix(in srgb, var(--text) 92%, var(--accent));
    text-shadow: 0 12px 38px rgba(167, 139, 250, 0.12);
    text-wrap: balance;
  }

  .eyebrow {
    margin: 0;
    color: var(--accent);
    font: 800 12px/1.2 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    max-width: 800px;
    margin: 0;
    font-size: clamp(42px, 6vw, 76px);
    line-height: 1;
  }

  .hero-copy,
  .page-intro {
    max-width: 680px;
    margin: 0;
    color: var(--muted);
    font-size: clamp(16px, 1.7vw, 18px);
    line-height: 1.78;
    text-wrap: balance;
  }

  .hero-copy {
    margin-top: 4px;
  }

  .hero-dashboard {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
    gap: 16px;
    align-items: stretch;
    width: min(900px, 100%);
  }

  .hero-panel,
  .post-card,
  .stat,
  .info-card {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(23, 27, 32, 0.88);
    box-shadow: var(--shadow);
  }

  .terminal-bar {
    display: flex;
    gap: 7px;
    padding: 13px 14px;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.03);
  }

  .terminal-bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--danger);
  }

  .terminal-bar span:nth-child(2) {
    background: var(--accent-2);
  }

  .terminal-bar span:nth-child(3) {
    background: var(--accent);
  }

  .terminal-body {
    display: grid;
    gap: 12px;
    padding: 20px;
    color: var(--muted);
    font: 14px/1.65 var(--font-mono);
  }

  .terminal-body strong {
    color: var(--text);
  }

  .prompt {
    color: var(--accent);
  }

  .section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100vh - 84px);
    padding: 42px 0;
  }

  html[data-path="/"] .section {
    scroll-snap-align: start;
  }

  html[data-path="/"] main > :last-child {
    scroll-snap-align: end;
  }

  .section.grid {
    display: grid;
    align-content: center;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 18px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 26px;
  }

  .section-heading p {
    max-width: 520px;
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .post-list {
    display: grid;
    gap: 14px;
    padding: 0;
    list-style: none;
  }

  .post-card {
    transition: border-color 160ms ease, transform 160ms ease, background 160ms ease;
  }

  .post-card:hover {
    border-color: rgba(216, 180, 254, 0.58);
    background: rgba(30, 36, 43, 0.94);
    transform: translateY(-2px);
  }

  .post-link {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 22px;
    padding: 22px;
  }

  .post-date {
    color: var(--faint);
    font: 700 13px/1.3 var(--font-mono);
  }

  .post-link h2 {
    margin: 0 0 8px;
    font-size: clamp(21px, 3vw, 28px);
    line-height: 1.18;
  }

  .post-link:hover h2 {
    color: var(--accent);
  }

  .meta,
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--muted);
    font-size: 14px;
  }

  .tags span {
    border: 1px solid rgba(240, 198, 110, 0.32);
    border-radius: 999px;
    padding: 4px 9px;
    color: var(--accent-2);
    font-size: 13px;
  }

  .post-description {
    margin: 0 0 16px;
    color: var(--muted);
    line-height: 1.7;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    height: 100%;
  }

  .stat,
  .info-card {
    padding: 18px;
  }

  .stat {
    display: grid;
    align-content: center;
    justify-items: center;
    min-height: 128px;
    text-align: center;
  }

  .stat strong {
    display: block;
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 900;
    line-height: 1;
  }

  .stat span,
  .info-card p {
    color: var(--muted);
    line-height: 1.7;
  }

  .prose {
    max-width: 780px;
    padding-top: 44px;
    font-size: 17px;
    line-height: 1.85;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    width: fit-content;
    margin-bottom: 24px;
    border: 1px solid rgba(216, 180, 254, 0.24);
    border-radius: 999px;
    background:
      linear-gradient(135deg, rgba(167, 139, 250, 0.12), rgba(216, 180, 254, 0.05)),
      rgba(23, 27, 32, 0.78);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.16);
    padding: 7px 13px 7px 8px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      transform 160ms ease,
      background 160ms ease;
  }

  .back-link span {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: rgba(167, 139, 250, 0.16);
    color: var(--accent);
    font-size: 15px;
    line-height: 1;
  }

  .back-link:hover {
    border-color: rgba(216, 180, 254, 0.66);
    background:
      linear-gradient(135deg, rgba(167, 139, 250, 0.18), rgba(216, 180, 254, 0.07)),
      rgba(30, 36, 43, 0.9);
    color: var(--text);
    transform: translateX(-2px);
  }

  .prose h1 {
    margin: 12px 0;
    font-size: clamp(34px, 5vw, 56px);
  }

  .prose a:not(.back-link) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .prose code {
    border-radius: 6px;
    background: var(--panel-2);
    padding: 2px 6px;
    font-size: 0.9em;
  }

  .prose pre {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #0d1117;
    padding: 18px;
  }

  .prose pre code {
    background: transparent;
    padding: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }

  .info-card h2 {
    margin: 0 0 10px;
    font-size: 20px;
  }

  @media (max-width: 820px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      width: 100%;
      overflow-x: auto;
    }

    .hero {
      grid-template-columns: 1fr;
      padding-top: 42px;
    }

    .hero-stack {
      margin-top: 0;
      gap: 20px;
    }

    .hero-title {
      gap: 24px;
    }

    .hero-dashboard {
      grid-template-columns: 1fr;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .post-link {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .stats {
      grid-template-columns: 1fr;
    }
  }
</style>
